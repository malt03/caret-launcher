<!--
  TextLauncher: resources copied from IntentResolver java/res/values (android-17.0.0_r1) that the
  copied grid item (layout/chooser_grid_item_hover.xml) and the stacked app dialog use.
-->
<resources>
    <!-- attrs.xml -->
    <declare-styleable name="ChooserTargetItemView">
        <attr name="focusOutlineColor" format="color" />
        <attr name="focusInnerOutlineColor" format="color" />
        <attr name="focusOutlineWidth" format="dimension" />
        <attr name="focusOutlineCornerRadius" format="dimension" />
    </declare-styleable>

    <!-- config.xml -->
    <integer name="config_chooser_max_targets_per_row">5</integer>

    <!-- dimens.xml -->
    <dimen name="chooser_icon_horizontal_padding">8dp</dimen>
    <dimen name="chooser_icon_vertical_padding">7dp</dimen>
    <dimen name="chooser_icon_width_with_padding">72dp</dimen>
    <dimen name="chooser_icon_height_with_padding">70dp</dimen>
    <dimen name="chooser_grid_target_name_text_size">12sp</dimen>
    <dimen name="chooser_grid_activity_name_text_size">12sp</dimen>
    <dimen name="chooser_item_focus_outline_corner_radius">11dp</dimen>
    <dimen name="chooser_item_focus_outline_width">2dp</dimen>
    <dimen name="grid_padding_vertical_hover">1dp</dimen>
    <dimen name="grid_padding_horizontal_hover">4dp</dimen>

    <!-- colors.xml -->
    <color name="chooser_grid_item_text1_color">@color/materialColorOnSurface</color>
    <color name="chooser_grid_item_text2_color">@color/materialColorOnSurfaceVariant</color>

    <!-- frameworks/libs/systemui dynamiccolors/res/values/colors.xml: the colors the resources above
         refer to, which IntentResolver gets from the platform's libraries. -->
    <color name="materialColorOnSurface">@android:color/system_on_surface_light</color>
    <color name="materialColorOnSurfaceVariant">@android:color/system_on_surface_variant_light</color>
    <color name="materialColorSecondaryFixed">@android:color/system_secondary_fixed_light</color>
    <color name="materialColorOnSecondaryFixedVariant">@android:color/system_on_secondary_fixed_variant_light</color>
</resources>
