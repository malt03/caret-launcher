<?xml version="1.0" encoding="utf-8"?>
<!--
  TextLauncher: resources copied from Launcher3 res/values (android-17.0.0_r1) that the copied
  folder and drag code uses: attrs.xml, colors.xml (values-v31 for the accent colors),
  config.xml and dimens.xml, and styles.xml (FastScrollerPopup) for the all apps fast scroller.
  drawable/round_rect_folder.xml and drawable/bg_letter_list_text.xml are copied as is.
-->
<resources>
    <attr name="folderPreviewColor" format="color" />
    <attr name="folderBackgroundColor" format="color" />
    <attr name="folderIconBorderColor" format="color" />
    <declare-styleable name="FolderIconPreview">
        <attr name="folderPreviewColor" />
        <attr name="folderIconBorderColor" />
    </declare-styleable>
    <color name="folder_background_light">#EFEDED</color>
    <color name="folder_background_dark">#1F2020</color>
    <color name="folder_preview_light">#7FCFFF</color>
    <color name="folder_preview_dark">#1E1F20</color>
    <integer name="config_materialFolderExpandDuration">200</integer>
    <dimen name="bg_round_rect_radius">8dp</dimen>
    <!-- dragndrop (util/ViewEx.kt also reads this id) -->
    <item type="id" name="perform_a11y_action_on_launcher_state_normal_tag" />
    <dimen name="blur_size_medium_outline">2dp</dimen>
    <dimen name="pre_drag_view_scale">6dp</dimen>
    <integer name="config_dropAnimMinDuration">100</integer>
    <integer name="config_dropAnimMaxDuration">500</integer>
    <integer name="config_dropAnimMaxDist">800</integer>
    <!-- CellLayout drop location -->
    <attr name="workspaceAccentColor" format="color" />
    <color name="workspace_accent_color_light">@android:color/system_accent1_100</color>
    <color name="workspace_accent_color_dark">@android:color/system_accent1_900</color>
    <dimen name="grid_visualization_rounding_radius">16dp</dimen>
    <dimen name="grid_visualization_horizontal_cell_spacing">6dp</dimen>
    <dimen name="grid_visualization_vertical_cell_spacing">6dp</dimen>
    <integer name="config_dragOutlineFadeTime">500</integer>
    <integer name="config_dragOutlineMaxAlpha">255</integer>
    <!-- DropTargetBar, ButtonDropTarget (drawable/drop_target_*.xml, drawable/ic_*_no_shadow.xml
         and color/drop_target_text.xml are copied as is) -->
    <dimen name="drag_distanceThreshold">30dp</dimen>
    <attr name="dropTargetHoverTextColor" format="color" />
    <attr name="dropTargetHoverButtonColor" format="color" />
    <color name="drop_target_hover_text_color_light">@android:color/system_accent1_900</color>
    <color name="drop_target_hover_text_color_dark">@android:color/system_accent1_100</color>
    <color name="drop_target_hover_button_color_light">@android:color/system_accent1_100</color>
    <color name="drop_target_hover_button_color_dark">@android:color/system_accent1_700</color>
    <dimen name="dynamic_grid_drop_target_size">56dp</dimen>
    <dimen name="drop_target_top_margin">32dp</dimen>
    <dimen name="drop_target_bottom_margin">16dp</dimen>
    <dimen name="button_drop_target_min_text_size">10sp</dimen>
    <dimen name="button_drop_target_resize_text_increment">1sp</dimen>
    <dimen name="drop_target_drag_padding">14dp</dimen>
    <dimen name="drop_target_text_size">16sp</dimen>
    <dimen name="drop_target_bar_margin_horizontal">4dp</dimen>
    <dimen name="drop_target_button_drawable_size">20dp</dimen>
    <dimen name="drop_target_button_drawable_padding">8dp</dimen>
    <dimen name="drop_target_button_drawable_horizontal_padding">16dp</dimen>
    <dimen name="drop_target_button_drawable_vertical_padding">8dp</dimen>
    <dimen name="drop_target_button_frame_radius">80dp</dimen>
    <dimen name="drop_target_button_gap">28dp</dimen>
    <dimen name="drop_target_button_workspace_edge_gap">0dp</dimen>
    <!-- frameworks/libs/systemui dynamiccolors (values-night has the dark ones) -->
    <color name="materialColorOnSurface">@android:color/system_on_surface_light</color>
    <color name="materialColorSurfaceContainer">@android:color/system_surface_container_light</color>
    <color name="materialColorSecondaryFixed">@android:color/system_secondary_fixed_light</color>
    <color name="materialColorOnSecondaryFixedVariant">@android:color/system_on_secondary_fixed_variant_light</color>

    <!-- Keyboard focus outline: keyboard/ItemFocusIndicatorHelper.java, FocusIndicatorHelper.java -->
    <attr name="focusOutlineColor" format="color" />
    <attr name="focusInnerOutlineColor" format="color" />
    <color name="focused_background">#80c6c5c5</color>
    <dimen name="focus_outline_radius">16dp</dimen>
    <dimen name="focus_inner_outline_radius">14dp</dimen>
    <dimen name="focus_outline_stroke_width">2dp</dimen>

    <!-- Long-press menu: AbstractFloatingView, ArrowPopup, PopupContainer and the system
         shortcut rows (layout/system_shortcut*.xml, drawable/popup_background.xml,
         drawable/*_item_primary.xml, drawable/info_24px.xml, drawable/gm_edit_24.xml,
         layout/deep_shortcut*.xml, drawable/ic_deepshortcut_placeholder.xml,
         drawable/ic_add_circle_filled.xml, drawable/deep_shortcuts_text_placeholder.xml and
         color/popup_shade_*.xml are copied as is) -->
    <attr name="popupColorPrimary" format="color" />
    <attr name="popupColorSecondary" format="color" />
    <attr name="popupColorTertiary" format="color" />
    <attr name="popupTextColor" format="color" />
    <attr name="popupShadeFirst" format="color" />
    <attr name="popupShadeSecond" format="color" />
    <attr name="popupShadeThird" format="color" />
    <declare-styleable name="BubbleTextView">
        <attr name="layoutHorizontal" format="boolean" />
        <attr name="iconSizeOverride" format="dimension" />
        <attr name="iconDisplay" format="integer">
            <enum name="workspace" value="0" />
            <enum name="all_apps" value="1" />
            <enum name="folder" value="2" />
            <enum name="widget_section" value="3" />
            <enum name="shortcut_popup" value="4" />
            <enum name="taskbar" value="5" />
            <enum name="search_result_tall" value="6" />
            <enum name="search_result_small" value="7" />
            <enum name="prediction_row" value="8" />
            <enum name="search_result_app_row" value="9" />
        </attr>
        <attr name="centerVertically" format="boolean" />
    </declare-styleable>
    <declare-styleable name="InsettableFrameLayout_Layout">
        <attr name="layout_ignoreInsets" format="boolean" />
    </declare-styleable>
    <!-- values-v31/colors.xml -->
    <color name="popup_color_primary_light">@android:color/system_accent2_50</color>
    <color name="popup_color_secondary_light">@android:color/system_neutral2_100</color>
    <color name="popup_color_tertiary_light">@android:color/system_neutral2_300</color>
    <color name="popup_color_primary_dark">@android:color/system_neutral2_800</color>
    <color name="popup_color_secondary_dark">@android:color/system_neutral1_900</color>
    <color name="popup_color_tertiary_dark">@android:color/system_neutral2_700</color>
    <color name="workspace_text_color_light">@android:color/system_neutral1_0</color>
    <!-- values-v34/colors.xml -->
    <color name="system_on_surface_light">@android:color/system_on_surface_light</color>
    <color name="system_on_surface_dark">@android:color/system_on_surface_dark</color>
    <!-- values/colors.xml -->
    <color name="popup_shade_first_light">#F9F9F9</color>
    <color name="popup_shade_second_light">#F1F1F1</color>
    <color name="popup_shade_third_light">#E2E2E2</color>
    <color name="popup_shade_first_dark">#303030</color>
    <color name="popup_shade_second_dark">#262626</color>
    <color name="popup_shade_third_dark">#1B1B1B</color>
    <!-- values/dimens.xml -->
    <dimen name="dialogCornerRadius">@dimen/default_dialog_corner_radius</dimen>
    <dimen name="default_dialog_corner_radius">26dp</dimen>
    <dimen name="popup_smaller_radius">4dp</dimen>
    <dimen name="popup_single_item_radius">100dp</dimen>
    <dimen name="deep_shortcuts_elevation">2dp</dimen>
    <dimen name="popup_margin">2dp</dimen>
    <dimen name="popup_arrow_width">12dp</dimen>
    <dimen name="popup_arrow_height">10dp</dimen>
    <dimen name="popup_arrow_vertical_offset">-1dp</dimen>
    <dimen name="popup_arrow_horizontal_center_offset">26dp</dimen>
    <dimen name="popup_arrow_corner_radius">2dp</dimen>
    <dimen name="popup_vertical_padding">4dp</dimen>
    <dimen name="bg_popup_item_width">216dp</dimen>
    <dimen name="bg_popup_item_height">52dp</dimen>
    <dimen name="deep_shortcuts_text_padding_start">54dp</dimen>
    <dimen name="popup_padding_end">14dp</dimen>
    <dimen name="system_shortcut_icon_size">20dp</dimen>
    <dimen name="system_shortcut_margin_start">16dp</dimen>
    <dimen name="system_shortcut_header_height">52dp</dimen>
    <dimen name="deep_shortcuts_start_drag_threshold">16dp</dimen>
    <dimen name="deep_shortcut_icon_size">35dp</dimen>
    <dimen name="deep_shortcut_drawable_padding">16dp</dimen>
    <dimen name="deep_shortcut_add_button_size">48dp</dimen>
    <dimen name="popup_padding_start">10dp</dimen>
    <dimen name="deep_shortcut_text_end_padding">48dp</dimen>
    <dimen name="system_shortcut_header_icon_touch_size">48dp</dimen>
    <dimen name="system_shortcut_header_icon_padding">14dp</dimen>
    <dimen name="system_shortcut_header_icon_padding_outer">16dp</dimen>
    <dimen name="system_shortcut_header_icon_padding_inner">12dp</dimen>
    <!-- values/config.xml -->
    <item type="id" name="popup_container" />
    <string name="popup_container_iterate_children" translatable="false">popup_container_iterate_children</string>
    <!-- values/styles.xml -->
    <style name="BaseIconRoot" parent="@android:style/TextAppearance.DeviceDefault.DialogWindowTitle"/>
    <style name="BaseIconUnBounded" parent="BaseIconRoot">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textColor">@color/workspace_text_color_light</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <!-- No shadows in the base theme -->
        <item name="android:shadowRadius">0</item>
    </style>
    <style name="BaseIcon" parent="BaseIconUnBounded">
        <item name="android:lines">1</item>
    </style>
    <style name="PopupItemIconOnly">
        <item name="android:colorControlHighlight">?attr/popupColorTertiary</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="PopupItem">
        <item name="android:colorControlHighlight">?attr/popupColorTertiary</item>
    </style>
    <!-- All apps fast scroller (views/RecyclerViewFastScroller.java, allapps/). -->
    <declare-styleable name="RecyclerViewFastScroller">
        <attr name="canThumbDetach" format="boolean" />
    </declare-styleable>
    <color name="materialColorSurface">@android:color/system_surface_light</color>
    <color name="materialColorSurfaceBright">@android:color/system_surface_bright_light</color>
    <dimen name="fastscroll_track_min_width">6dp</dimen>
    <dimen name="fastscroll_track_max_width">8dp</dimen>
    <dimen name="fastscroll_thumb_padding">1dp</dimen>
    <dimen name="fastscroll_thumb_height">52dp</dimen>
    <dimen name="fastscroll_thumb_touch_inset">-24dp</dimen>
    <dimen name="fastscroll_popup_width">75dp</dimen>
    <dimen name="fastscroll_popup_height">62dp</dimen>
    <dimen name="fastscroll_popup_padding">13dp</dimen>
    <dimen name="fastscroll_popup_text_size">32dp</dimen>
    <dimen name="fastscroll_popup_margin">19dp</dimen>
    <dimen name="fastscroll_list_letter_size">5dp</dimen>
    <dimen name="bg_letter_list_text_size">20sp</dimen>
    <dimen name="fastscroll_width">58dp</dimen>
    <dimen name="fastscroll_end_margin">-26dp</dimen>
    <dimen name="all_apps_header_top_padding">36dp</dimen>
    <dimen name="all_apps_header_bottom_padding">14dp</dimen>
    <style name="FastScrollerPopup" parent="@android:style/TextAppearance.DeviceDefault.DialogWindowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">@dimen/fastscroll_popup_width</item>
        <item name="android:layout_height">@dimen/fastscroll_popup_height</item>
        <item name="android:textSize">@dimen/fastscroll_popup_text_size</item>
        <item name="android:paddingEnd">@dimen/fastscroll_popup_padding</item>
        <item name="android:gravity">center</item>
        <item name="android:alpha">0</item>
        <item name="android:elevation">3dp</item>
        <item name="android:saveEnabled">false</item>
        <item name="android:textColor">?android:attr/textColorPrimaryInverse</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <!-- All apps open and close gestures (touch/BaseSwipeDetector.java). -->
    <dimen name="base_swift_detector_fling_release_velocity">1dp</dimen>
    <!-- The wallpaper dependent workspace text (util/Themes.getActivityThemeRes). attrs.xml,
         values-v31/colors.xml. The AppTheme styles are declared here for R.style and defined
         by the app (res/values/themes.xml), which overrides them. -->
    <attr name="isWorkspaceDarkText" format="boolean" />
    <attr name="workspaceTextColor" format="color" />
    <attr name="workspaceShadowColor" format="color" />
    <color name="workspace_text_color_dark">@android:color/system_neutral1_1000</color>
    <style name="AppTheme" />
    <style name="AppTheme.DarkMainColor" />
    <style name="AppTheme.DarkText" />
    <style name="AppTheme.Dark" />
    <style name="AppTheme.Dark.DarkMainColor" />
    <style name="AppTheme.Dark.DarkText" />
    <!-- The home screen while editing (states/SpringLoadedState.java, CellLayout's background,
         DragLayer's workspace drag scrim): attrs.xml, values-v31/colors.xml, dimens.xml.
         drawable-v28/bg_celllayout.xml is copied as is (minSdk 33 always uses it), and
         color/cell_layout_bg_color.xml is copied as is. -->
    <attr name="workspaceSurfaceColor" format="color" />
    <color name="workspace_surface_color">@android:color/system_accent1_100</color>
    <color name="wallpaper_popup_scrim">@android:color/system_neutral1_900</color>
    <dimen name="spring_loaded_panel_border">2dp</dimen>
    <dimen name="spring_loaded_hotseat_top_margin">76dp</dimen>
    <dimen name="dynamic_grid_spring_loaded_min_next_space_visible">48dp</dimen>
    <!-- The all apps bottom sheet (layout/all_apps_bottom_sheet_background.xml,
         drawable/bg_rounded_corner_bottom_sheet_handle.xml) and the depth's blur:
         attrs.xml, colors.xml, dimens.xml, quickstep/res/values/config.xml. -->
    <attr name="bottomSheetDragHandleColor" format="color" />
    <!-- TextLauncher: Pixel Launcher's values (the framework's shade_panel colors, which follow the
         dark theme) instead of AOSP's #66D9E2FF and #1AFFFFFF. -->
    <color name="blur_shade_panel_fg">@color/shade_panel_fg_color</color>
    <color name="blur_shade_panel_bg">@color/shade_panel_bg_color</color>
    <dimen name="bottom_sheet_handle_area_height">36dp</dimen>
    <dimen name="bottom_sheet_handle_width">32dp</dimen>
    <dimen name="bottom_sheet_handle_height">4dp</dimen>
    <dimen name="bottom_sheet_handle_margin">16dp</dimen>
    <dimen name="bottom_sheet_handle_corner_radius">2dp</dimen>
    <dimen name="max_depth_blur_radius_enhanced">30dp</dimen>
    <item name="workspace_content_scale" format="float" type="dimen">0.97</item>
    <color name="materialColorOutlineVariant">@android:color/system_outline_variant_light</color>
</resources>
