<?xml version="1.0" encoding="utf-8"?>
<!--
  search_hint, search_hint_share and menu_app_info are taken from Launcher3
  res/values*/strings.xml (android-17.0.0_r1): all_apps_search_bar_hint, abandoned_search,
  app_info_drop_target_label.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Kept in English in every language but zh-CN, where launchers are called 桌面
         (research/app-name/README.md). -->
    <string name="app_name" tools:ignore="MissingTranslation">Caret Launcher</string>
    <string name="search_hint">Search apps</string>
    <string name="search_hint_share">Search</string>
    <string name="menu_search_terms">Search keywords</string>
    <!-- The long-press menu item when menu_search_terms does not fit on its one line. -->
    <string name="menu_search_terms_short">Keywords</string>
    <string name="search_terms_title">Search keywords for %1$s</string>
    <string name="search_terms_hint">Add a keyword</string>
    <string name="search_terms_add">Add</string>
    <string name="search_terms_close">Close</string>
    <string name="search_terms_remove">Remove</string>
    <string name="share_text_title">Share text</string>
    <string name="share_text_message">Choose up to 3 apps to show next to the search field. Tap one to share the text you typed.</string>
    <string name="share_text_move_up">Move up</string>
    <string name="share_text_move_down">Move down</string>
    <!-- The licenses (docs/spec.md 8): the row of the app's settings screen and the title of its page. -->
    <string name="licenses">Licenses</string>
</resources>
